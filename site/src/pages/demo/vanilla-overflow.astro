---
import DemoLayout from '../../layouts/DemoLayout.astro'

// A dedicated fixture, not a query-param variant of /demo/vanilla: this
// project builds to a static site, so a query-param-gated item list would
// only ever render its overflowing branch under the dev server, never in a
// real build/preview. A separate route works identically in all three.
//
// Twenty items comfortably overflows 85dvh on both target devices at the
// menu's own per-item height (padding 1rem + min-block-size 3rem ≈ 80px):
// roughly 1600px of content against a ~780-790px budget.
const items = Array.from({ length: 20 }, (_, i) => `Item ${i + 1}`)
---
<DemoLayout system="vanilla">
  <main data-tz-app>
    <h1>thumbzone — vanilla (overflowing menu)</h1>
    <p>Fixture for testing touch scrolling inside a menu taller than the sheet.</p>
  </main>

  <div class="tz-scrim" data-tz-scrim></div>

  <div
    id="tz-sheet"
    class="tz-sheet"
    data-tz-sheet
    data-tz-open="false"
    role="dialog"
    aria-modal="true"
    aria-label="Main menu"
    inert
  >
    <div class="tz-handle" data-tz-handle aria-hidden="true"></div>
    <ul class="tz-menu" data-tz-menu>
      {items.map((item) => <li><a href="#">{item}</a></li>)}
    </ul>
  </div>

  <!-- Named for the menu, not for the next action — see /demo/vanilla. -->
  <button class="tz-trigger" data-tz-trigger type="button" aria-expanded="false" aria-controls="tz-sheet" aria-label="Menu">
    <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
      <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2" />
    </svg>
  </button>
</DemoLayout>

<style is:global>
  @import '../../../../systems/vanilla/src/demo.css';
  @import '../../../../systems/vanilla/src/thumbzone.css';
</style>

<script>
  import { initThumbzone } from '../../../../systems/vanilla/src/thumbzone.js'

  const thumbzone = initThumbzone({
    trigger: document.querySelector('[data-tz-trigger]'),
    sheet: document.querySelector('[data-tz-sheet]'),
    scrim: document.querySelector('[data-tz-scrim]'),
    menu: document.querySelector('[data-tz-menu]'),
    inertRoot: document.querySelector('[data-tz-app]'),
  })

  // Exposed only so e2e tests can drive the imperative API (destroy(), in
  // particular, has no attribute-driven equivalent to trigger from a test).
  // @ts-expect-error — deliberate test hook, not part of the page's own contract.
  window.__thumbzone = thumbzone
</script>
