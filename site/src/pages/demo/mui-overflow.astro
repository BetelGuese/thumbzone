---
import DemoLayout from '../../layouts/DemoLayout.astro'
import ThumbzoneMenu from '../../../../systems/mui/src/ThumbzoneMenu.tsx'
import '../../../../systems/mui/src/fonts'

// A dedicated fixture, not a query-param variant of /demo/mui — this project
// builds to a static site, so a query-param-gated item list would only ever
// render its overflowing branch under the dev server, never in a real
// build/preview. A separate route works identically in all three, exactly as
// vanilla-overflow.astro does for the reference implementation.
//
// Thirty items comfortably overflows 85dvh on both target devices: every
// ListItemButton is floored at MIN_HIT_TARGET (48px) by the port's own
// styling, so the list alone is at least ~1440px tall against a ~780-790px
// budget for the sheet's max-block-size — past it even before MUI's own
// padding and line-height add anything on top of that floor.
const items = Array.from({ length: 30 }, (_, i) => `Item ${i + 1}`)
---
<DemoLayout system="mui">
  <main data-tz-app>
    <h1>thumbzone — Material UI (overflowing menu)</h1>
    <p>Fixture for testing touch scrolling inside a menu taller than the sheet.</p>
  </main>
  <ThumbzoneMenu items={items} client:load />
</DemoLayout>

<script>
  import { initThumbzone, liveThumbzone } from '../../../../systems/mui/src/thumbzone'

  // Wired here, from the page, for the same reason /demo/mui wires from its own
  // module script rather than leaving it to the island's mount: client:load
  // hydrates from a dynamic import(), and the document's 'load' event — which
  // is what page.goto() in the suite waits for — does not wait for one. A test
  // that drives real input the instant navigation resolves would otherwise be
  // racing React, Emotion and MUI downloading, and an input event dispatched
  // before any listener exists is not one a later hydration can retroactively
  // answer.
  //
  // Unlike /demo/mui, this route publishes none of the contract's three test
  // hooks. Both exist for a reason that does not apply to this fixture: the
  // overflow suite never calls destroy() or re-initialises over this markup —
  // it drives the sheet entirely through real input (a click, a scroll, a
  // touch) — so nothing here ever reorders the menu after load for a hydration
  // in flight to race against, and there is no imperative API for a test to
  // reach that the DOM's own attributes do not already expose.
  const sheet = document.querySelector('[data-tz-sheet]')
  liveThumbzone(sheet) ??
    initThumbzone({
      sheet,
      trigger: document.querySelector('[data-tz-trigger]'),
      scrim: document.querySelector('[data-tz-scrim]'),
      menu: document.querySelector('[data-tz-menu]'),
      inertRoot: document.querySelector('[data-tz-app]'),
    })
</script>

<style is:global>
  @import '../../../../systems/mui/src/demo.css';
</style>
