---
import DemoLayout from '../../layouts/DemoLayout.astro'
import ThumbzoneMenu from '../../../../systems/mantine/src/ThumbzoneMenu.tsx'
import '../../../../systems/mantine/src/thumbzone.css'

// A dedicated fixture, not a query-param variant of /demo/mantine — this
// project builds to a static site, so a query-param-gated item list would
// only ever render its overflowing branch under the dev server, never in a
// real build/preview. A separate route works identically in all three,
// exactly as vanilla-overflow.astro does for the reference implementation.
//
// Long enough that the menu is a scroll container of its own on the shortest
// device profile the suite runs (iPhone 14 Pro Max, 740px tall).
// `thumbzone.css`'s own rules, not Mantine's: every menu row is floored at
// MIN_HIT_TARGET (48px) by `[data-tz-menu] a { min-block-size:
// var(--tz-hit-target) }`, and List adds no gap between its own rows here —
// its `--list-spacing` custom property is only ever set from a `spacing` prop
// (List.mjs's varsResolver), and ThumbzoneMenu.tsx passes none, so it
// resolves through the rule's own `var(--list-spacing, 0)` fallback instead.
// The menu's own padding is `--mantine-spacing-xs`, 10px on every side. N
// items therefore run N×48 + 20px, against a budget the sheet's own
// max-block-size (85dvh, 629px at this profile's 740px viewport) has already
// cut down: 72px reserved for the trigger's own footprint (`--tz-trigger-size`
// 56px + `--tz-trigger-gap` 16px) and 48px for the drag handle come off the
// top before the menu gets any of what is left (509px). 20 items run
// 20×48 + 20 = 980px, well past that.
const items = Array.from({ length: 20 }, (_, i) => `Item ${i + 1}`)
---
{/* This route's document deliberately does not scroll. The checks that visit
    it drive the menu's own scrollTop (e2e/scroll-and-order.spec.ts,
    e2e/clearance.spec.ts), never the page's, so there is nothing here for a
    document-level scroll to serve — unlike /demo/mantine, one line of prose
    is enough. */}
<DemoLayout system="mantine" rootAttrs={{ 'data-mantine-color-scheme': 'light' }}>
  <main data-tz-app>
    <h1>thumbzone — Mantine (overflowing menu)</h1>
    <p>Fixture for testing touch scrolling inside a menu taller than the sheet.</p>
  </main>
  <ThumbzoneMenu items={items} client:load />
</DemoLayout>

<script>
  import { initThumbzone, liveThumbzone } from '../../../../systems/mantine/src/thumbzone'

  // Wired here, from the page, for the same reason /demo/mantine wires from
  // its own module script rather than leaving it to the island's mount:
  // client:load hydrates from a dynamic import(), and the document's 'load'
  // event — which is what page.goto() in the suite waits for — does not wait
  // for one. A test that drives real input the instant navigation resolves
  // would otherwise be racing React and Mantine downloading, and an input
  // event dispatched before any listener exists is not one a later hydration
  // can retroactively answer.
  //
  // Unlike /demo/mantine, this route publishes none of the contract's three
  // test hooks. Both exist for a reason that does not apply to this fixture:
  // the overflow suite never calls destroy() or re-initialises over this
  // markup — it drives the sheet entirely through real input (a click, a
  // scroll, a touch) — so nothing here ever reorders the menu after load for a
  // hydration in flight to race against, and there is no imperative API for a
  // test to reach that the DOM's own attributes do not already expose.
  const sheet = document.querySelector('[data-tz-sheet]')
  liveThumbzone(sheet) ??
    initThumbzone({
      sheet,
      trigger: document.querySelector('[data-tz-trigger]'),
      scrim: document.querySelector('[data-tz-scrim]'),
      menu: document.querySelector('[data-tz-menu]'),
      inertRoot: document.querySelector('[data-tz-app]'),
    })
</script>
