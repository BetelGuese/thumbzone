---
import DemoLayout from '../../layouts/DemoLayout.astro'
import ThumbzoneMenu from '../../../../systems/chakra/src/ThumbzoneMenu.tsx'

// A dedicated fixture, not a query-param variant of /demo/chakra — this
// project builds to a static site, so a query-param-gated item list would
// only ever render its overflowing branch under the dev server, never in a
// real build/preview. A separate route works identically in all three,
// exactly as vanilla-overflow.astro does for the reference implementation.
//
// Long enough that the menu is a scroll container of its own on the shortest
// device profile the suite runs (iPhone 14 Pro Max, 740px tall). Every List.Item
// is floored at MIN_HIT_TARGET (48px) by the port's own minBlockSize, and
// List.Root adds a 4px gap between items (Chakra's spacing.1) and 8px of
// padding on every side (spacing.2): 24 items run 24×48 + 23×4 + 16 = 1260px,
// against a budget the sheet's own max-block-size (85dvh) has already cut down —
// 72px reserved for the trigger's own footprint (sizes.14 + spacing.4) and 48px
// for the drag handle come off the top before the menu gets any of what is
// left.
const items = Array.from({ length: 24 }, (_, i) => `Item ${i + 1}`)
---
<DemoLayout system="chakra">
  <main data-tz-app>
    <h1>thumbzone — Chakra UI (overflowing menu)</h1>
    <p>Fixture for testing touch scrolling inside a menu taller than the sheet.</p>
  </main>
  <ThumbzoneMenu items={items} client:load />
</DemoLayout>

<script>
  import { initThumbzone, liveThumbzone } from '../../../../systems/chakra/src/thumbzone'

  // Wired here, from the page, for the same reason /demo/chakra wires from its
  // own module script rather than leaving it to the island's mount: client:load
  // hydrates from a dynamic import(), and the document's 'load' event — which
  // is what page.goto() in the suite waits for — does not wait for one. A test
  // that drives real input the instant navigation resolves would otherwise be
  // racing React, Emotion and Chakra downloading, and an input event
  // dispatched before any listener exists is not one a later hydration can
  // retroactively answer.
  //
  // Unlike /demo/chakra, this route publishes none of the contract's three
  // test hooks. Both exist for a reason that does not apply to this fixture:
  // the overflow suite never calls destroy() or re-initialises over this
  // markup — it drives the sheet entirely through real input (a click, a
  // scroll, a touch) — so nothing here ever reorders the menu after load for a
  // hydration in flight to race against, and there is no imperative API for a
  // test to reach that the DOM's own attributes do not already expose.
  const sheet = document.querySelector('[data-tz-sheet]')
  liveThumbzone(sheet) ??
    initThumbzone({
      sheet,
      trigger: document.querySelector('[data-tz-trigger]'),
      scrim: document.querySelector('[data-tz-scrim]'),
      menu: document.querySelector('[data-tz-menu]'),
      inertRoot: document.querySelector('[data-tz-app]'),
    })
</script>

<style is:global>
  @import '../../../../systems/chakra/src/demo.css';
</style>
