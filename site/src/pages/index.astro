---
import {
  CORNER_REACH_DISTANCE,
  DESKTOP_BREAKPOINT,
  DISMISS_RATIO,
  FLING_VELOCITY,
  MAX_TRIGGER_BOTTOM_GAP,
  MIN_HIT_TARGET,
} from '../../../core/index.js'
import { PLANNED_SYSTEMS, SHIPPED_SYSTEMS } from '../../../systems/registry'
import { joinBase } from '../lib/routes'

// Every demo route reaches this page as a root-relative literal from the
// registry, and Astro rewrites nothing for `base` beyond the assets it emits
// itself — so on a deployment served under a path these have to be joined
// explicitly or they point above it. The conformance suite runs against a
// build with no base, where this resolves to the identity, so it is
// `site/test/routes.test.ts` and the deployment guard that hold the joining
// honest rather than any assertion the suite makes.
const BASE = import.meta.env.BASE_URL

const REPO = 'https://github.com/BetelGuese/thumbzone'

// A common logical phone width, clamped below the width at which the pattern
// hides itself. The clamp is the point: a frame at or above the breakpoint
// would render a demo with no trigger, no sheet and no scrim — the port
// behaving exactly as the contract requires — and the page would look fine
// while demonstrating nothing. Deriving the bound from the constant rather
// than writing a number here means that mistake is not available to make.
const PHONE_WIDTH = 390
const FRAME_WIDTH = Math.min(PHONE_WIDTH, DESKTOP_BREAKPOINT - 1)
const FRAME_HEIGHT = 780

const initialSystem = SHIPPED_SYSTEMS[0]

/**
 * One line per system: what that design system's own primitive could not do,
 * and where the full account lives.
 *
 * Deliberately not in systems/registry.ts. That file is the contract a porter
 * reads, and a field that exists only to render a landing page would make it
 * serve two audiences at once. The coupling is held by e2e/showcase.spec.ts
 * instead, which fails if a shipped system has no entry here.
 */
const NOTES: Record<string, { text: string; href: string; linkText: string }> = {
  vanilla: {
    text:
      'The normative reference. Dependency-free, and a 61-line adapter over the shared ' +
      'behaviour — no framework to bind to and no drawer to reach past.',
    href: `${REPO}#what-is-enforced-not-just-claimed`,
    linkText: 'What conformance means',
  },
  mui: {
    text:
      'Material UI’s temporary Drawer writes its transform imperatively, and its Modal hides ' +
      'siblings from assistive technology — including the trigger, which has to stay reachable ' +
      'to close the sheet. The port uses the docked variant and owns the motion itself.',
    href: `${REPO}#what-the-first-port-changed`,
    linkText: 'What the first port changed',
  },
  shadcn: {
    text:
      'shadcn’s Drawer is Vaul, which independently arrives at the same dismiss ratio and the ' +
      'same release curve — and at one different fling constant, hard-coded with no prop to ' +
      'configure it. The port drives the shared maths, so the agreement stands as corroboration ' +
      'rather than as a dependency.',
    href: `${REPO}#what-the-second-port-confirmed`,
    linkText: 'What the second port confirmed',
  },
  tailwind: {
    text:
      'No component primitive at all — the first port written in utility classes. Three ' +
      'requirements need something else: the breakpoint, a length two elements have to agree ' +
      'on, and a value that lives in JavaScript.',
    href: `${REPO}#what-the-third-port-established`,
    linkText: 'What the third port established',
  },
  bootstrap: {
    text:
      'Bootstrap’s Offcanvas runs a lifecycle of its own — backdrop, focus trap, scroll lock, ' +
      'Escape — all of it already owned here. CSS only; no Bootstrap JavaScript is imported ' +
      'anywhere, and a check enforces it.',
    href: `${REPO}#what-the-fourth-port-settled`,
    linkText: 'What the fourth port settled',
  },
  chakra: {
    text:
      'Chakra’s Drawer wraps Ark UI’s Dialog, and a closed Dialog server-renders no content at ' +
      'all — nothing for a page to wire during load, nothing to reorder before hydration, and ' +
      'nothing for the open transition to move. Every part of the lifecycle it owns is a ' +
      'configurable flag, so it is the absent markup that rules it out rather than the ownership.',
    href: `${REPO}#what-the-fifth-port-showed`,
    linkText: 'What the fifth port showed',
  },
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>thumbzone — a mobile menu where the thumb already is</title>
    <meta
      name="description"
      content="The mobile hamburger menu belongs at the bottom centre, not in a top corner. One pattern, every major design system, one executable conformance suite."
    />
  </head>
  <body>
    <nav class="topnav" aria-label="Sections">
      <span class="nav-brand">thumbzone</span>
      <a href="#ports">Ports</a>
      <a href="#conformance">Conformance</a>
      <a href="#contribute">Contribute</a>
      <a class="btn btn-primary" href={joinBase(BASE, initialSystem.route)}>Open the demo</a>
    </nav>

    <main data-tz-showcase>
      <section class="hero wrap">
        <h1 class="display"><span class="line">Your menu is in</span> <span class="line">the wrong corner.</span></h1>
        <div class="hero-copy">
            <p class="sub">
              On a 6.7&Prime; phone the navigation icon in the top app bar sits roughly
              {CORNER_REACH_DISTANCE}px from a thumb resting on the bottom edge — 152mm on a
              display 154mm tall, so the reach is as long as the phone. It needs a grip shift
              or a second hand. Every design system’s default app bar puts the primary
              navigation trigger exactly there. thumbzone puts it where the thumb already is:
              bottom centre.
            </p>

            <div class="row">
              <a class="btn btn-primary" href={joinBase(BASE, initialSystem.route)}>Try it on a phone</a>
              <a class="btn btn-ghost" href={REPO}>Source</a>
              {/* Rendered by a third-party script, so it arrives after load and
                  outside this page's scoped styles — hence the wrapper, which is
                  what the row's own layout can reach. */}
              <span class="bmc-slot">
                <script
                  is:inline
                  type="text/javascript"
                  src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"
                  data-name="bmc-button"
                  data-slug="b3t3lgu3s3"
                  data-color="#FFDD00"
                  data-emoji=""
                  data-font="Inter"
                  data-text="Buy me a coffee"
                  data-outline-color="#000000"
                  data-font-color="#000000"
                  data-coffee-color="#ffffff"
                ></script>
              </span>
            </div>
          </div>

        <svg
          data-tz-reach
          class="reach"
          role="img"
          aria-label="Two phone outlines. On the left, a trigger in the top-left corner sits far outside the arc a resting thumb sweeps. On the right, a trigger at the bottom centre sits inside it, reachable with either hand."
          viewBox="0 0 320 200"
        >
          <!-- Hand-authored rather than generated: it carries the headline
               claim, so it is worth drawing deliberately. Two 6.7-inch
               outlines at the same scale, the same thumb arc on both, and
               the trigger moved from outside it to inside it. -->
          <g fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="53" y="20" width="74" height="156" rx="9" />
            <rect x="193" y="20" width="74" height="156" rx="9" />

            <!-- One circular sweep about the resting thumb, identical on both
                 outlines: the reach is the constant here, and the trigger is
                 the only thing that moves. -->
            <path d="M53 123.8A64 64 0 0 1 127 123.8" stroke-dasharray="5 4" />
            <path d="M193 123.8A64 64 0 0 1 267 123.8" stroke-dasharray="5 4" />

            <circle cx="71" cy="38" r="9" />
            <path d="M66 34.5h10M66 38h10M66 41.5h10" stroke-width="1.2" />
            <circle cx="230" cy="158" r="9" />
            <path d="M225 154.5h10M225 158h10M225 161.5h10" stroke-width="1.2" />

            <path d="M89.5 172 72.4 47.9" stroke-width="1" stroke-dasharray="2 3" />
          </g>

          <g fill="currentColor">
            <circle cx="90" cy="176" r="3" />
            <circle cx="230" cy="176" r="3" />
            <text x="95" y="104" font-size="9">{CORNER_REACH_DISTANCE}px</text>
            <text x="90" y="192" font-size="9" text-anchor="middle">out of reach</text>
            <text x="230" y="192" font-size="9" text-anchor="middle">reachable either-handed</text>
          </g>
        </svg>
      </section>

      <section class="stats" aria-label="thumbzone, by the numbers">
        <div class="wrap">
          <div class="stat-band">
            <div><p class="stat-num">{CORNER_REACH_DISTANCE}px</p><p class="stat-label">Thumb to the app bar icon</p></div>
            <div><p class="stat-num">{MIN_HIT_TARGET}&times;{MIN_HIT_TARGET}</p><p class="stat-label">Minimum trigger, px</p></div>
            <div><p class="stat-num">{SHIPPED_SYSTEMS.length}</p><p class="stat-label">Design systems, one pattern</p></div>
            <div><p class="stat-num">0</p><p class="stat-label">Axe violations, closed &amp; open</p></div>
          </div>
        </div>
      </section>

      <section class="wrap split" data-tz-demo aria-labelledby="tz-demo-heading" id="ports">
        <div class="split-copy">
          {/* Derived, not written: this line and the heading below both went
              stale the moment a sixth port shipped, and a count in prose has no
              way to notice. */}
          <span class="kicker">{SHIPPED_SYSTEMS.length} design systems, one pattern</span>
          <h2 id="tz-demo-heading" class="split-title">One pattern, every ground</h2>

          <nav aria-label="Choose a design system">
            <ul class="features">
              {
                SHIPPED_SYSTEMS.map((system, i) => (
                  <li class="feature" data-tz-current={system.id === initialSystem.id ? '' : undefined}>
                    <p class="f-num">{String(i + 1).padStart(2, '0')}</p>
                    <h3 class="f-title">
                      <a href={joinBase(BASE, system.route)} data-tz-system={system.id}>
                        {system.label}
                      </a>
                    </h3>
                    <p class="f-copy" data-tz-note={system.id}>
                      {NOTES[system.id]?.text}
                      <a class="more" href={NOTES[system.id]?.href}>{NOTES[system.id]?.linkText} &rarr;</a>
                    </p>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        {/* The width is handed to CSS rather than repeated in it, so the panel
            drawn around the frame is sized from the same clamped figure the
            frame itself carries and cannot drift from it. */}
        <div data-tz-frame-host style={`--tz-frame-inline-size: ${FRAME_WIDTH}px`}>
          <iframe
            data-tz-frame
            src={joinBase(BASE, initialSystem.route)}
            title={`${initialSystem.label} demo`}
            width={FRAME_WIDTH}
            height={FRAME_HEIGHT}
          ></iframe>
          <p data-tz-frame-caption>{FRAME_WIDTH}px wide</p>
          <p data-tz-caveat>
            This is a viewport, not a phone, and a mouse is not a thumb. Open it on one to judge
            the gesture; the argument is about reach, and reach is something you feel.
          </p>
        </div>
      </section>

      <div class="wrap"><hr class="rule" /></div>

      <section class="wrap checks" aria-labelledby="tz-contract-heading" id="conformance">
        <span class="kicker">Enforced, not claimed</span>
        <h2 id="tz-contract-heading">An executable conformance suite</h2>
        <p class="lede">
          Behaviour is defined by an executable conformance suite parameterised over the systems
          registry. Registering a port is what subjects it to every check; there is no way to
          register a system and not be tested.
        </p>
        <ul data-tz-contract class="check-grid">
          <li class="check">Hidden entirely at and above {DESKTOP_BREAKPOINT}px — a mobile pattern, not a replacement for one.</li>
          <li class="check">Trigger at least {MIN_HIT_TARGET}×{MIN_HIT_TARGET}px, within {MAX_TRIGGER_BOTTOM_GAP}px of the bottom edge.</li>
          <li class="check">Dismissed past {DISMISS_RATIO * 100}% of sheet height, or on a downward fling at {FLING_VELOCITY}px/ms.</li>
          <li class="check">Zero axe violations across WCAG 2.0, 2.1 and 2.2 A and AA, sheet closed and open.</li>
        </ul>
        <p class="links">
          {/* Kept on one line: a newline after the separator is trimmed rather
              than collapsed to a space, which runs the two links together. */}
          <a href={`${REPO}#what-is-enforced-not-just-claimed`}>The full list &rarr;</a> · <a href={`${REPO}/actions/workflows/ci.yml`}>Every run &rarr;</a>
        </p>
      </section>

      <div class="wrap"><hr class="rule" /></div>

      <section class="wrap close" aria-labelledby="tz-planned-heading" id="contribute">
        <h2 id="tz-planned-heading">Awaiting a port</h2>
        <p class="sub">
          The registry is open. Each of these needs markup and styling in its own system's
          idiom — the behaviour is already shared, and the suite already knows how to judge it.
        </p>
        <ul data-tz-planned class="tags">
          {PLANNED_SYSTEMS.map((system) => <li class="tag tag-outline">{system.label}</li>)}
        </ul>
        <div class="row">
          <a class="btn btn-primary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>How to add one</a>
          <a class="btn btn-ghost" href={REPO}>Source</a>
        </div>
      </section>

      <footer class="wrap">
        <p><a href={REPO}>Source</a> · MIT</p>
        <span class="bmc-slot">
          <script
            is:inline
            type="text/javascript"
            src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"
            data-name="bmc-button"
            data-slug="b3t3lgu3s3"
            data-color="#FFDD00"
            data-emoji=""
            data-font="Inter"
            data-text="Buy me a coffee"
            data-outline-color="#000000"
            data-font-color="#000000"
            data-coffee-color="#ffffff"
          ></script>
        </span>
      </footer>
    </main>
  </body>
</html>

<style>
  /* Nocturne skin — a committed dark ground, a 28px leading lattice, and
     fading rules. The palette is the supplied design's; the type is this
     project's own existing stack, because the font configuration is
     deliberately not touched here. Every metric of the design that is not the
     typeface — scale, leading, tracking, weight, rhythm — is preserved. */
  :root {
    --leading: 28px;
    --half: 14px;
    --edge: clamp(20px, 5vw, 72px);
    --measure: 58ch;

    /* Nocturne, mapped onto this page's existing token names so the
       functional rules below keep working unchanged. */
    --tz-page: #161826;
    --tz-ink: #e9e9ed;
    --tz-quiet: color-mix(in srgb, #e9e9ed 72%, transparent);
    --tz-rule: color-mix(in srgb, #e9e9ed 16%, transparent);
    --tz-panel: #232532;
    --tz-neutral-700: #595d6c;

    --tz-accent: #9184d9;
    --tz-accent-300: #d2cefd;
    --tz-accent-900: #2b2741;
    --tz-section: #262a60;
    --tz-section-glow: #353b80;

    /* The framed demo declares no colour scheme of its own and is rendered
       light, so the surface behind it stays light in either scheme. */
    --tz-screen: #fbfbfa;

    --tz-sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --tz-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;

    --tz-radius-md: 8px;
    --tz-shadow-lg: 0 0 0 1px #9397ab, 0 16px 40px rgba(0, 0, 0, 0.65);
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    font-family: var(--tz-sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--tz-ink);
    /* Painted explicitly rather than left transparent: this page commits to
       one ground in both schemes, so nothing behind it may show through. */
    background:
      radial-gradient(
        1200px 720px at 82% -160px,
        color-mix(in srgb, var(--tz-accent-900) 75%, transparent),
        transparent 60%
      ),
      radial-gradient(1100px 800px at -10% 100%, color-mix(in srgb, black 30%, transparent), transparent 55%),
      var(--tz-page);
    /* The supplied design also set a line-breaking declaration here. It is
       deliberately absent: the utility scanner reads this file as raw text and
       lifted that property's own name out as a class candidate, compiling a
       dead rule into two port bundles. Cosmetic line-breaking is not worth a
       rule nothing applies — and note this comment cannot name the property or
       the utility either, for precisely the same reason. Verified by building
       before and after: both bundles hold their pinned surface. */
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--edge);
  }

  a {
    color: var(--tz-accent-300);
    text-decoration: none;
  }

  a:hover {
    color: var(--tz-accent);
  }

  .rule {
    height: 1px;
    border: 0;
    margin: 0;
    background: linear-gradient(
      to right,
      transparent,
      var(--tz-rule) 48px calc(100% - 48px),
      transparent
    );
  }

  /* — top navigation — */
  .topnav {
    display: flex;
    align-items: center;
    gap: 11.2px;
    padding: 8.4px 11.2px;
    padding-inline: max(var(--edge), calc((100% - 1200px) / 2 + var(--edge)));
  }

  .nav-brand {
    font-weight: 500;
    font-size: 18px;
    margin-right: auto;
  }

  .topnav a {
    color: inherit;
    font-size: 14px;
    white-space: nowrap;
  }

  .topnav a:hover {
    color: var(--tz-accent);
  }

  @media (max-width: 480px) {
    .topnav a:not(.btn) {
      display: none;
    }
  }

  /* — buttons — */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.2;
    color: var(--tz-ink);
    background: transparent;
    border: 1px solid transparent;
    padding: 5.6px 10.08px;
    border-radius: var(--tz-radius-md);
  }

  .btn-primary {
    color: var(--tz-accent);
    border-color: var(--tz-accent);
  }

  .btn-primary:hover {
    background: color-mix(in srgb, var(--tz-accent) 12%, transparent);
  }

  .btn-ghost {
    color: var(--tz-accent);
    padding-inline: 2.8px;
  }

  .btn-ghost:hover {
    background: color-mix(in srgb, var(--tz-accent) 10%, transparent);
  }

  /* — kicker — */
  .kicker {
    position: relative;
    display: block;
    font-size: 13px;
    line-height: var(--half);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tz-accent);
    font-feature-settings: 'tnum' 1;
    margin: 0 0 calc(var(--leading) - var(--half));
  }

  /* — hero — */
  .hero {
    padding: calc(3 * var(--leading)) var(--edge) calc(2 * var(--leading));
  }

  .display {
    font-weight: 500;
    font-size: clamp(44px, 6.4vw, 88px);
    line-height: clamp(49px, 7.13vw, 98px);
    letter-spacing: -0.015em;
    margin: 0 0 0 -0.06em;
  }

  .display .line {
    display: block;
  }

  .hero .sub {
    font-size: 17px;
    line-height: var(--leading);
    max-width: var(--measure);
    margin: calc(1.5 * var(--leading) - 1cap) 0 0;
    color: var(--tz-ink);
  }

  .row {
    display: flex;
    gap: 8.4px;
    flex-wrap: wrap;
    margin-top: var(--leading);
  }

  /* The support button is injected by a third-party script after load, so this
     page's scoped styles cannot reach the element itself — only the wrapper it
     lands in. Centring it here is what keeps it on the same baseline as the
     buttons beside it, whatever height the script decides to render. */
  .bmc-slot {
    display: inline-flex;
    align-items: center;
  }

  .reach {
    display: block;
    inline-size: min(420px, 100%);
    margin-top: calc(1.5 * var(--leading));
    color: var(--tz-quiet);
  }

  /* The diagram carries the headline claim, so it belongs beside the sentence
     that states it rather than stranded below the buttons — which also spends
     the empty half the hero otherwise leaves at wide widths. It stacks back
     under the copy below this width, where there is only one column to have. */
  @media (min-width: 62rem) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      /* Declared rather than implicit: a spanning item's `-1` line resolves
         against the *explicit* grid, so without these two rows the diagram
         below silently collapsed into row 1 and centred on the headline. */
      grid-template-rows: auto auto;
      column-gap: clamp(24px, 5vw, 80px);
      align-items: center;
    }

    /* The headline keeps the full measure rather than being squeezed into the
       first column: at this size it is two lines by design, and a column narrow
       enough to sit beside the diagram would break it into four. It therefore
       spans both columns, and the diagram — which occupies both rows — overlaps
       the half of that span the text does not reach. */
    .display {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .hero-copy {
      grid-column: 1;
      grid-row: 2;
    }

    /* Spanning both rows is what centres it against the whole hero rather than
       against the copy alone — measured, because centring it on the copy left
       it a hundred pixels below the hero's own middle. */
    .reach {
      grid-column: 2;
      grid-row: 1 / -1;
      margin-top: 0;
      align-self: center;
      justify-self: center;
    }
  }

  /* — stat band — */
  .stats {
    background:
      radial-gradient(
        900px 420px at 85% -40%,
        color-mix(in srgb, var(--tz-section-glow) 70%, transparent),
        transparent 64%
      ),
      var(--tz-section);
    padding: calc(2.5 * var(--leading)) 0;
  }

  .stat-band {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(1.5 * var(--leading)) var(--leading);
  }

  .stat-num {
    font-weight: 500;
    font-size: clamp(36px, 3.6vw, 52px);
    line-height: calc(2 * var(--leading));
    color: var(--tz-ink);
    font-feature-settings: 'tnum' 1;
    margin: 0 0 0 -0.055em;
  }

  .stat-label {
    font-size: 13px;
    line-height: var(--half);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tz-ink) 72%, transparent);
    margin: var(--half) 0 0;
  }

  /* — ports: the switcher, drawn as numbered rule-parted rows — */
  .split {
    padding: calc(3 * var(--leading)) var(--edge) calc(2.5 * var(--leading));
  }

  .split-title {
    font-weight: 500;
    font-size: 32px;
    line-height: calc(1.5 * var(--leading));
    letter-spacing: -0.012em;
    margin: 0;
  }

  .split nav {
    margin-top: calc(1.5 * var(--leading));
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(36px, 56px) minmax(0, 1fr);
    gap: 0 clamp(16px, 3vw, 40px);
    padding: calc(1.25 * var(--leading)) 0;
    border-inline-start: 2px solid transparent;
    padding-inline-start: 12px;
  }

  .feature + .feature {
    position: relative;
  }

  .feature + .feature::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--tz-neutral-700) 48px calc(100% - 48px),
      transparent
    );
  }

  .f-num {
    font-weight: 500;
    font-size: 15px;
    line-height: var(--leading);
    color: var(--tz-accent);
    font-feature-settings: 'tnum' 1;
    margin: 0;
  }

  .f-title {
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .f-title a {
    color: inherit;
  }

  .f-title a:hover {
    color: var(--tz-accent-300);
  }

  [data-tz-note] {
    grid-column: 2;
    font-size: 15.5px;
    line-height: var(--leading);
    color: color-mix(in srgb, var(--tz-ink) 82%, transparent);
    margin: var(--half) 0 0;
    max-width: 52ch;
  }

  .more {
    display: block;
    margin-top: var(--half);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  /* — conformance checks — */
  .checks {
    padding: calc(2.5 * var(--leading)) var(--edge) calc(2.5 * var(--leading));
  }

  .checks h2 {
    font-weight: 500;
    font-size: 32px;
    line-height: calc(1.5 * var(--leading));
    letter-spacing: -0.012em;
    margin: 0;
  }

  .checks .lede {
    font-size: 15.5px;
    line-height: var(--leading);
    color: color-mix(in srgb, var(--tz-ink) 82%, transparent);
    margin: calc(var(--leading) - 1cap) 0 0;
    max-width: var(--measure);
  }

  .check-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--leading) clamp(24px, 4vw, 72px);
    margin: calc(1.5 * var(--leading)) 0 0;
    padding: 0;
  }

  .check {
    position: relative;
    padding-left: 24px;
    font-size: 14.5px;
    line-height: var(--leading);
    color: color-mix(in srgb, var(--tz-ink) 82%, transparent);
    max-width: 44ch;
  }

  .check::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--leading) / 2);
    width: 12px;
    height: 1px;
    background: var(--tz-accent);
  }

  .links {
    margin-top: calc(1.5 * var(--leading));
    font-size: 13px;
    line-height: var(--half);
    letter-spacing: 0.02em;
  }

  /* — awaiting a port — */
  .close {
    padding: calc(2 * var(--leading)) var(--edge);
  }

  .close h2 {
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    margin: 0;
  }

  .close .sub {
    font-size: 15.5px;
    line-height: var(--leading);
    color: color-mix(in srgb, var(--tz-ink) 82%, transparent);
    margin: calc(var(--leading) - 1cap) 0 0;
    max-width: var(--measure);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 5.6px;
    margin: var(--leading) 0 0;
    padding: 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.02em;
    padding: 3px 10px;
    border-radius: 6px;
  }

  .tag-outline {
    border: 1px solid var(--tz-accent);
    color: var(--tz-accent);
  }

  footer {
    padding: calc(2 * var(--leading)) var(--edge);
    font-size: 13px;
    line-height: var(--leading);
    color: color-mix(in srgb, var(--tz-ink) 72%, transparent);
  }

  /* ——— functional rules, carried over unchanged in behaviour ———
     Mobile first: a reader already holding a phone does not need a simulation
     of one. Below the breakpoint the frame does not appear at all, and the
     switcher links are ordinary navigation to the demo routes, full-screen
     and under a real thumb.

     The width is a literal because a CSS media condition cannot read a custom
     property, which is the same constraint systems/vanilla/src/thumbzone.css
     works under. It is held to DESKTOP_BREAKPOINT by e2e/showcase.spec.ts,
     probed at the boundary rather than well past it. */
  [data-tz-frame-host] {
    --tz-frame-pad: clamp(0.75rem, 2vw, 1.25rem);
    --tz-screen-radius: 0.75rem;
    display: none;
    text-align: center;
    padding: var(--tz-frame-pad);
    background: var(--tz-panel);
    border: 1px solid var(--tz-rule);
    /* Concentric with the screen it surrounds — the same radius plus the
       padding between the two, which is what makes the surround read as
       something built to hold the screen rather than a plate that happens to
       be behind it. That reading is what a dark ground needs from it: the one
       light rectangle on the page has to look deliberate. */
    border-radius: calc(var(--tz-screen-radius) + var(--tz-frame-pad));
  }

  [data-tz-frame-caption] {
    font-family: var(--tz-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tz-ink) 60%, transparent);
    margin: var(--half) 0 0;
  }

  [data-tz-caveat] {
    font-size: 14px;
    line-height: calc(1.5 * var(--half));
    color: color-mix(in srgb, var(--tz-ink) 78%, transparent);
    margin: var(--half) auto 0;
    max-width: 44ch;
    text-align: start;
  }

  /* Every system's note is shown at every width. The desktop layout used to
     hide four of the five and reveal only the framed system's, which made the
     switcher a list of five bare names next to one paragraph — a reader
     comparing ports could see one port's findings at a time and had to click
     four times to read the argument the page exists to make.

     Which system is in the frame is carried instead by the marker down the
     row's edge and by `aria-current` on its link. That was always the stronger
     signal: note visibility announced nothing to assistive technology, so a
     screen-reader user never had the indication this rule was protecting. */
  @media (min-width: 768px) {
    /* Bounded by the frame's own width plus what is drawn around it, so the
       panel closes on the demo instead of stretching a plate of empty ground
       across the page at the widths where this is still one column. The
       padding is added to that figure rather than taken out of it — this
       sizes the surround, and leaves what the frame renders at alone. */
    [data-tz-frame-host] {
      display: block;
      margin: calc(1.5 * var(--leading)) auto 0;
      max-inline-size: calc(var(--tz-frame-inline-size) + 2 * var(--tz-frame-pad) + 2px);
    }

    /* The rule down the edge of a row means "this is the system in the
       frame", so it is drawn only where a frame exists. The server marks the
       first system whatever the width, and marking it below the breakpoint
       would announce a choice the reader never made. */
    [data-tz-showcase] nav li[data-tz-current] {
      border-inline-start-color: var(--tz-accent);
    }
  }

  @media (min-width: 62rem) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--leading) clamp(24px, 5vw, 96px);
      align-items: start;
    }

    /* Held in view while the column beside it is read, so the demo does not
       scroll away from the argument it is there to support. */
    [data-tz-frame-host] {
      grid-column: 2;
      margin: 0;
      align-self: flex-start;
      position: sticky;
      inset-block-start: clamp(1rem, 4dvh, 2.5rem);
    }
  }

  @media (max-width: 880px) {
    .check-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: calc(2 * var(--leading));
    }

    .stat-band {
      justify-content: start;
      gap: var(--leading) calc(2 * var(--leading));
    }
  }

  /* Deliberately reaches past this page's scoping. Switching systems replaces
     the frame with an element the script creates itself, which carries none of
     the generated attributes a scoped rule matches on — so a scoped version of
     this would style the frame the server rendered and then stop applying the
     moment a reader chose anything else, which is precisely the state nobody
     reviews.

     No width and no edge of its own, either. The width is the attribute the
     server computed against DESKTOP_BREAKPOINT: a rule that overrode it would
     let the framed demo widen enough to put away its own trigger and sheet,
     and an edge drawn here would come out of the viewport inside instead,
     framing the demo at a width it was never sized for. The surround is drawn
     by the panel around it, where it costs the demo nothing. A corner radius
     costs it nothing either — it clips, it does not lay out — so that is where
     the screen gets its shape.

     The colour scheme is the load-bearing declaration here. A demo route
     declares none of its own, so it is rendered light; its root and its body
     are both transparent, which leaves the browser to paint the canvas under
     them. Where this element's scheme and the framed document's agree, that
     canvas stays transparent and whatever is declared here shows through;
     where they differ, the browser paints an opaque one of its own on top — so
     a reader on a dark ground got a white slab, and a background declared here
     went underneath it and never appeared at all. Pinning this element to
     light makes the two agree, which both hands the rule below a canvas it can
     actually set and keeps the ports on the ground their colours were chosen
     and contrast-tested against. Deliberately done from the showcase and not
     in the demo layout: that layout is shared by every demo route and
     answerable to the conformance suite, and teaching it to follow the
     reader's scheme would restyle every port on the strength of one page's
     appearance. */
  [data-tz-frame-host] :global(iframe[data-tz-frame]) {
    display: block;
    margin-inline: auto;
    border: 0;
    border-radius: var(--tz-screen-radius);
    color-scheme: light;
    background: var(--tz-screen);
    box-shadow: var(--tz-shadow-lg);
    /* Never taller than the viewport it is being read in. The trigger this
       whole page is about sits at the frame's *bottom* edge, so a frame that
       overflows does not merely get cropped — it hides the one control a
       visitor is meant to reach for, while still looking like a working demo.
       Height is the safe dimension to give up: the width is what has to stay
       under the breakpoint, and it is untouched here. dvh rather than the
       static unit the guard scans this file for: a collapsing mobile URL bar
       makes that one the wrong measure, and the guard does not accept it
       anywhere under site/src. */
    block-size: min(780px, calc(100dvh - 11rem));
  }
</style>

<script>
  import { DESKTOP_BREAKPOINT } from '../../../core/index.js'

  const host = document.querySelector('[data-tz-frame-host]')
  const links = document.querySelectorAll('a[data-tz-system]')

  // Below the breakpoint the frame is hidden and these links are the page's
  // real navigation: a reader on a phone wants the demo full-screen under an
  // actual thumb, not a simulation of a phone inside a phone. Matching the
  // same width the frame is shown at keeps one rule governing both.
  const framesAreShown = window.matchMedia(`(min-width: ${DESKTOP_BREAKPOINT}px)`)

  function swap(route, label) {
    const current = host?.querySelector('iframe')
    if (!current) return

    // Replaced rather than re-pointed. Assigning `src` to a frame already in
    // the document navigates it, and that navigation pushes an entry onto
    // *this* page's session history — so a reader who tried three systems and
    // pressed Back would walk backwards through the switcher instead of
    // leaving. A newly inserted frame's first load is a replacement, not a
    // push. It also guarantees a clean document: these routes wire a pointer
    // state machine, a focus trap and a scroll tracker at init, and a reused
    // frame would carry whatever state the last one was left in.
    const next = document.createElement('iframe')
    // Dimensions are copied from the element the server rendered rather than
    // recomputed here, so the width that is clamped against the breakpoint at
    // build time has exactly one source.
    next.width = current.width
    next.height = current.height
    next.setAttribute('data-tz-frame', '')
    next.title = `${label} demo`
    next.src = route
    current.replaceWith(next)
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      // Let the browser do its normal thing when the frame is not on screen,
      // and for any click the reader meant to open elsewhere.
      if (!framesAreShown.matches) return
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return

      event.preventDefault()
      swap(link.getAttribute('href') ?? '', link.textContent?.trim() ?? '')

      for (const other of links) other.removeAttribute('aria-current')
      link.setAttribute('aria-current', 'page')

      for (const item of document.querySelectorAll('[data-tz-current]')) {
        item.removeAttribute('data-tz-current')
      }
      link.closest('li')?.setAttribute('data-tz-current', '')
    })
  }

  // The server renders no aria-current, because without scripting these are
  // ordinary links to other pages and none of them is the current one.
  if (framesAreShown.matches) links[0]?.setAttribute('aria-current', 'page')
</script>
