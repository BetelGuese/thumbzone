---
import { DESKTOP_BREAKPOINT } from '../../../core/index.js'
import { PLANNED_SYSTEMS, SHIPPED_SYSTEMS } from '../../../systems/registry'

const REPO = 'https://github.com/BetelGuese/thumbzone'

// A common logical phone width, clamped below the width at which the pattern
// hides itself. The clamp is the point: a frame at or above the breakpoint
// would render a demo with no trigger, no sheet and no scrim — the port
// behaving exactly as the contract requires — and the page would look fine
// while demonstrating nothing. Deriving the bound from the constant rather
// than writing a number here means that mistake is not available to make.
const PHONE_WIDTH = 390
const FRAME_WIDTH = Math.min(PHONE_WIDTH, DESKTOP_BREAKPOINT - 1)
const FRAME_HEIGHT = 780

const initialSystem = SHIPPED_SYSTEMS[0]

/**
 * One line per system: what that design system's own primitive could not do,
 * and where the full account lives.
 *
 * Deliberately not in systems/registry.ts. That file is the contract a porter
 * reads, and a field that exists only to render a landing page would make it
 * serve two audiences at once. The coupling is held by e2e/showcase.spec.ts
 * instead, which fails if a shipped system has no entry here.
 */
const NOTES: Record<string, { text: string; href: string; linkText: string }> = {
  vanilla: {
    text:
      'The normative reference. Dependency-free, and a 61-line adapter over the shared ' +
      'behaviour — no framework to bind to and no drawer to reach past.',
    href: `${REPO}#what-is-enforced-not-just-claimed`,
    linkText: 'What conformance means',
  },
  mui: {
    text:
      'Material UI’s temporary Drawer writes its transform imperatively, and its Modal hides ' +
      'siblings from assistive technology — including the trigger, which has to stay reachable ' +
      'to close the sheet. The port uses the docked variant and owns the motion itself.',
    href: `${REPO}#what-the-first-port-changed`,
    linkText: 'What the first port changed',
  },
  shadcn: {
    text:
      'shadcn’s Drawer is Vaul, which independently arrives at the same dismiss ratio and the ' +
      'same release curve — and at one different fling constant, hard-coded with no prop to ' +
      'configure it. The port drives the shared maths, so the agreement stands as corroboration ' +
      'rather than as a dependency.',
    href: `${REPO}#what-the-second-port-confirmed`,
    linkText: 'What the second port confirmed',
  },
  tailwind: {
    text:
      'No component primitive at all — the first port written in utility classes. Three ' +
      'requirements need something else: the breakpoint, a length two elements have to agree ' +
      'on, and a value that lives in JavaScript.',
    href: `${REPO}#what-the-third-port-established`,
    linkText: 'What the third port established',
  },
  bootstrap: {
    text:
      'Bootstrap’s Offcanvas runs a lifecycle of its own — backdrop, focus trap, scroll lock, ' +
      'Escape — all of it already owned here. CSS only; no Bootstrap JavaScript is imported ' +
      'anywhere, and a check enforces it.',
    href: `${REPO}#what-the-fourth-port-settled`,
    linkText: 'What the fourth port settled',
  },
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>thumbzone — a mobile menu where the thumb already is</title>
    <meta
      name="description"
      content="The mobile hamburger menu belongs at the bottom centre, not in a top corner. One pattern, five design systems, one executable conformance suite."
    />
  </head>
  <body>
    <main data-tz-showcase>
      <header>
        <h1>thumbzone</h1>
        <p>Your menu is in the wrong corner.</p>
      </header>

      <section aria-labelledby="tz-demo-heading">
        <h2 id="tz-demo-heading">Five design systems, one pattern</h2>
        <nav aria-label="Choose a design system">
          <ul>
            {
              SHIPPED_SYSTEMS.map((system) => (
                <li data-tz-current={system.id === initialSystem.id ? '' : undefined}>
                  <a href={system.route} data-tz-system={system.id}>
                    {system.label}
                  </a>
                  <p data-tz-note={system.id}>
                    {NOTES[system.id]?.text} <a href={NOTES[system.id]?.href}>{NOTES[system.id]?.linkText}</a>
                  </p>
                </li>
              ))
            }
          </ul>
        </nav>

        <div data-tz-frame-host>
          <iframe
            data-tz-frame
            src={initialSystem.route}
            title={`${initialSystem.label} demo`}
            width={FRAME_WIDTH}
            height={FRAME_HEIGHT}
          ></iframe>
          <p data-tz-frame-caption>{FRAME_WIDTH} × {FRAME_HEIGHT}</p>
        </div>
      </section>

      <section aria-labelledby="tz-planned-heading">
        <h2 id="tz-planned-heading">Awaiting a port</h2>
        <ul data-tz-planned>
          {PLANNED_SYSTEMS.map((system) => <li>{system.label}</li>)}
        </ul>
        <p><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>How to add one</a></p>
      </section>

      <footer>
        <p><a href={REPO}>Source</a> · MIT</p>
      </footer>
    </main>
  </body>
</html>

<style>
  /* Mobile first: a reader already holding a phone does not need a
     simulation of one. The frame is hidden and the switcher links are
     ordinary navigation to the demo routes, full-screen and under a real
     thumb.

     The width is a literal because a CSS media condition cannot read a
     custom property, which is the same constraint
     systems/vanilla/src/thumbzone.css works under. It is held to
     DESKTOP_BREAKPOINT by e2e/showcase.spec.ts, probed at the boundary
     rather than well past it. */
  [data-tz-frame-host] {
    display: none;
  }

  @media (min-width: 768px) {
    [data-tz-frame-host] {
      display: block;
    }
  }

  /* Below the breakpoint every note is shown, beside the link it describes:
     there is no frame here for a caption to caption, and the links are the
     page's real navigation. Showing one system's note against five systems'
     links would read as though it applied to all of them.

     From the breakpoint up the note becomes a caption for the framed demo,
     so exactly one belongs on screen. Driven by data-tz-current rather than
     by aria-current, so the server can mark the initially framed system
     without asserting anything about navigation for a reader with no
     scripting. */
  @media (min-width: 768px) {
    [data-tz-note] {
      display: none;
    }

    [data-tz-current] [data-tz-note] {
      display: block;
    }
  }
</style>

<script>
  import { DESKTOP_BREAKPOINT } from '../../../core/index.js'

  const host = document.querySelector('[data-tz-frame-host]')
  const links = document.querySelectorAll('a[data-tz-system]')

  // Below the breakpoint the frame is hidden and these links are the page's
  // real navigation: a reader on a phone wants the demo full-screen under an
  // actual thumb, not a simulation of a phone inside a phone. Matching the
  // same width the frame is shown at keeps one rule governing both.
  const framesAreShown = window.matchMedia(`(min-width: ${DESKTOP_BREAKPOINT}px)`)

  function swap(route, label) {
    const current = host?.querySelector('iframe')
    if (!current) return

    // Replaced rather than re-pointed. Assigning `src` to a frame already in
    // the document navigates it, and that navigation pushes an entry onto
    // *this* page's session history — so a reader who tried three systems and
    // pressed Back would walk backwards through the switcher instead of
    // leaving. A newly inserted frame's first load is a replacement, not a
    // push. It also guarantees a clean document: these routes wire a pointer
    // state machine, a focus trap and a scroll tracker at init, and a reused
    // frame would carry whatever state the last one was left in.
    const next = document.createElement('iframe')
    // Dimensions are copied from the element the server rendered rather than
    // recomputed here, so the width that is clamped against the breakpoint at
    // build time has exactly one source.
    next.width = current.width
    next.height = current.height
    next.setAttribute('data-tz-frame', '')
    next.title = `${label} demo`
    next.src = route
    current.replaceWith(next)
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      // Let the browser do its normal thing when the frame is not on screen,
      // and for any click the reader meant to open elsewhere.
      if (!framesAreShown.matches) return
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return

      event.preventDefault()
      swap(link.getAttribute('href') ?? '', link.textContent?.trim() ?? '')

      for (const other of links) other.removeAttribute('aria-current')
      link.setAttribute('aria-current', 'page')

      for (const item of document.querySelectorAll('[data-tz-current]')) {
        item.removeAttribute('data-tz-current')
      }
      link.closest('li')?.setAttribute('data-tz-current', '')
    })
  }

  // The server renders no aria-current, because without scripting these are
  // ordinary links to other pages and none of them is the current one.
  if (framesAreShown.matches) links[0]?.setAttribute('aria-current', 'page')
</script>
