---
import {
  DESKTOP_BREAKPOINT,
  DISMISS_RATIO,
  FLING_VELOCITY,
  MAX_TRIGGER_BOTTOM_GAP,
  MIN_HIT_TARGET,
} from '../../../core/index.js'
import { PLANNED_SYSTEMS, SHIPPED_SYSTEMS } from '../../../systems/registry'

const REPO = 'https://github.com/BetelGuese/thumbzone'

// A common logical phone width, clamped below the width at which the pattern
// hides itself. The clamp is the point: a frame at or above the breakpoint
// would render a demo with no trigger, no sheet and no scrim — the port
// behaving exactly as the contract requires — and the page would look fine
// while demonstrating nothing. Deriving the bound from the constant rather
// than writing a number here means that mistake is not available to make.
const PHONE_WIDTH = 390
const FRAME_WIDTH = Math.min(PHONE_WIDTH, DESKTOP_BREAKPOINT - 1)
const FRAME_HEIGHT = 780

const initialSystem = SHIPPED_SYSTEMS[0]

/**
 * One line per system: what that design system's own primitive could not do,
 * and where the full account lives.
 *
 * Deliberately not in systems/registry.ts. That file is the contract a porter
 * reads, and a field that exists only to render a landing page would make it
 * serve two audiences at once. The coupling is held by e2e/showcase.spec.ts
 * instead, which fails if a shipped system has no entry here.
 */
const NOTES: Record<string, { text: string; href: string; linkText: string }> = {
  vanilla: {
    text:
      'The normative reference. Dependency-free, and a 61-line adapter over the shared ' +
      'behaviour — no framework to bind to and no drawer to reach past.',
    href: `${REPO}#what-is-enforced-not-just-claimed`,
    linkText: 'What conformance means',
  },
  mui: {
    text:
      'Material UI’s temporary Drawer writes its transform imperatively, and its Modal hides ' +
      'siblings from assistive technology — including the trigger, which has to stay reachable ' +
      'to close the sheet. The port uses the docked variant and owns the motion itself.',
    href: `${REPO}#what-the-first-port-changed`,
    linkText: 'What the first port changed',
  },
  shadcn: {
    text:
      'shadcn’s Drawer is Vaul, which independently arrives at the same dismiss ratio and the ' +
      'same release curve — and at one different fling constant, hard-coded with no prop to ' +
      'configure it. The port drives the shared maths, so the agreement stands as corroboration ' +
      'rather than as a dependency.',
    href: `${REPO}#what-the-second-port-confirmed`,
    linkText: 'What the second port confirmed',
  },
  tailwind: {
    text:
      'No component primitive at all — the first port written in utility classes. Three ' +
      'requirements need something else: the breakpoint, a length two elements have to agree ' +
      'on, and a value that lives in JavaScript.',
    href: `${REPO}#what-the-third-port-established`,
    linkText: 'What the third port established',
  },
  bootstrap: {
    text:
      'Bootstrap’s Offcanvas runs a lifecycle of its own — backdrop, focus trap, scroll lock, ' +
      'Escape — all of it already owned here. CSS only; no Bootstrap JavaScript is imported ' +
      'anywhere, and a check enforces it.',
    href: `${REPO}#what-the-fourth-port-settled`,
    linkText: 'What the fourth port settled',
  },
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>thumbzone — a mobile menu where the thumb already is</title>
    <meta
      name="description"
      content="The mobile hamburger menu belongs at the bottom centre, not in a top corner. One pattern, five design systems, one executable conformance suite."
    />
  </head>
  <body>
    <main data-tz-showcase>
      <header>
        <h1>thumbzone</h1>
        <p>Your menu is in the wrong corner.</p>

        <p>
          On a 6.7&Prime; phone the top-left corner sits roughly 640px from a thumb resting at the
          bottom of the screen. Reaching it needs a grip shift or a second hand. Every design
          system’s default app bar puts the primary navigation trigger exactly there.
        </p>

        <svg
          data-tz-reach
          role="img"
          aria-label="Two phone outlines. On the left, a trigger in the top-left corner sits far outside the arc a resting thumb sweeps. On the right, a trigger at the bottom centre sits inside it, reachable with either hand."
          viewBox="0 0 320 200"
        >
          <!-- Hand-authored rather than generated: it carries the headline
               claim, so it is worth drawing deliberately. Two 6.7-inch
               outlines at the same scale, the same thumb arc on both, and
               the trigger moved from outside it to inside it. -->
          <g fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="53" y="20" width="74" height="156" rx="9" />
            <rect x="193" y="20" width="74" height="156" rx="9" />

            <!-- One circular sweep about the resting thumb, identical on both
                 outlines: the reach is the constant here, and the trigger is
                 the only thing that moves. -->
            <path d="M53 123.8A64 64 0 0 1 127 123.8" stroke-dasharray="5 4" />
            <path d="M193 123.8A64 64 0 0 1 267 123.8" stroke-dasharray="5 4" />

            <circle cx="71" cy="38" r="9" />
            <path d="M66 34.5h10M66 38h10M66 41.5h10" stroke-width="1.2" />
            <circle cx="230" cy="158" r="9" />
            <path d="M225 154.5h10M225 158h10M225 161.5h10" stroke-width="1.2" />

            <path d="M89.5 172 72.4 47.9" stroke-width="1" stroke-dasharray="2 3" />
          </g>

          <g fill="currentColor">
            <circle cx="90" cy="176" r="3" />
            <circle cx="230" cy="176" r="3" />
            <text x="95" y="104" font-size="9">640px</text>
            <text x="90" y="192" font-size="9" text-anchor="middle">out of reach</text>
            <text x="230" y="192" font-size="9" text-anchor="middle">reachable either-handed</text>
          </g>
        </svg>
      </header>

      <section data-tz-demo aria-labelledby="tz-demo-heading">
        <h2 id="tz-demo-heading">Five design systems, one pattern</h2>
        <nav aria-label="Choose a design system">
          <ul>
            {
              SHIPPED_SYSTEMS.map((system) => (
                <li data-tz-current={system.id === initialSystem.id ? '' : undefined}>
                  <a href={system.route} data-tz-system={system.id}>
                    {system.label}
                  </a>
                  <p data-tz-note={system.id}>
                    {NOTES[system.id]?.text} <a href={NOTES[system.id]?.href}>{NOTES[system.id]?.linkText}</a>
                  </p>
                </li>
              ))
            }
          </ul>
        </nav>

        {/* The width is handed to CSS rather than repeated in it, so the panel
            drawn around the frame is sized from the same clamped figure the
            frame itself carries and cannot drift from it. */}
        <div data-tz-frame-host style={`--tz-frame-inline-size: ${FRAME_WIDTH}px`}>
          <iframe
            data-tz-frame
            src={initialSystem.route}
            title={`${initialSystem.label} demo`}
            width={FRAME_WIDTH}
            height={FRAME_HEIGHT}
          ></iframe>
          <p data-tz-frame-caption>{FRAME_WIDTH} × {FRAME_HEIGHT}</p>
          <p data-tz-caveat>
            This is a viewport, not a phone, and a mouse is not a thumb. Open it on one to judge
            the gesture; the argument is about reach, and reach is something you feel.
          </p>
        </div>
      </section>

      <section aria-labelledby="tz-contract-heading">
        <h2 id="tz-contract-heading">Enforced, not claimed</h2>
        <p>
          Behaviour is defined by an executable conformance suite parameterised over the systems
          registry. Registering a port is what subjects it to every check; there is no way to
          register a system and not be tested.
        </p>
        <ul data-tz-contract>
          <li>Hidden entirely at and above {DESKTOP_BREAKPOINT}px — a mobile pattern, not a replacement for one.</li>
          <li>Trigger at least {MIN_HIT_TARGET}×{MIN_HIT_TARGET}px, within {MAX_TRIGGER_BOTTOM_GAP}px of the bottom edge.</li>
          <li>Dismissed past {DISMISS_RATIO * 100}% of sheet height, or on a downward fling at {FLING_VELOCITY}px/ms.</li>
          <li>Zero axe violations across WCAG 2.0, 2.1 and 2.2 A and AA, sheet closed and open.</li>
        </ul>
        <p>
          {/* Kept on one line: a newline after the separator is trimmed rather
              than collapsed to a space, which runs the two links together. */}
          <a href={`${REPO}#what-is-enforced-not-just-claimed`}>The full list</a> · <a href={`${REPO}/actions/workflows/ci.yml`}>Every run</a>
        </p>
      </section>

      <section aria-labelledby="tz-planned-heading">
        <h2 id="tz-planned-heading">Awaiting a port</h2>
        <ul data-tz-planned>
          {PLANNED_SYSTEMS.map((system) => <li>{system.label}</li>)}
        </ul>
        <p><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>How to add one</a></p>
      </section>

      <footer>
        <p><a href={REPO}>Source</a> · MIT</p>
      </footer>
    </main>
  </body>
</html>

<style>
  /* Set like the document it describes. System sans carries the argument;
     monospace carries every value the suite actually fixes — system names,
     dimensions, clause numbers — so what is enforced never looks like what
     is merely asserted. Nothing here encodes meaning in hue, which is what
     lets the page survive either colour scheme, and greyscale, intact. */
  html {
    box-sizing: border-box;
    color-scheme: light dark;

    --tz-page: #fbfbfa;
    --tz-ink: #16181d;
    --tz-quiet: #585d66;
    --tz-rule: #d8d9dd;
    --tz-panel: #f1f1ef;

    --tz-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --tz-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }

  /* Written out rather than derived from the values above. A page arguing
     that a reader's circumstances are worth designing around cannot treat
     the scheme they chose as an afterthought — so both sets were measured,
     and the muted ink clears 4.5:1 against its own page colour in each. */
  @media (prefers-color-scheme: dark) {
    html {
      --tz-page: #0d0f12;
      --tz-ink: #e9ebee;
      --tz-quiet: #9aa1aa;
      --tz-rule: #272b32;
      --tz-panel: #14171a;
    }
  }

  /* Stated outright rather than set once on the root and inherited from
     there. This page's styles are scoped by an attribute the compiler
     splices into every selector, including this one — which leaves the
     universal rule out-specifying the root rule it would be depending on,
     so the root resolves the inherited value against no parent at all and
     the initial value cascades everywhere instead. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--tz-page);
    color: var(--tz-ink);
    font-family: var(--tz-sans);
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
  }

  [data-tz-showcase] {
    counter-reset: tz-section;
    max-inline-size: 64rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem);
  }

  /* Links carry no colour of their own — the page has no accent to spend, and
     one introduced here would be the only thing on it encoding meaning in
     hue. The rule beneath the text is what marks them, so it is set at the
     muted ink rather than at the hairline colour: a separator nobody can see
     is not an affordance. */
  [data-tz-showcase] a {
    color: inherit;
    text-decoration-color: var(--tz-quiet);
    text-decoration-thickness: 1px;
  }

  /* Both properties, because most of these links sit inside muted prose,
     where they already share their surroundings' colour: raising the text to
     full strength is what actually reads as a response to the pointer. */
  [data-tz-showcase] a:hover {
    color: var(--tz-ink);
    text-decoration-color: currentColor;
  }

  /* Nothing above removes the browser's own indicator, so this strengthens
     one that is already there rather than standing in for it — an engine
     that does not recognise the modifier in this selector leaves a reader
     who never touches a pointer with the default, not with nothing.
     Spelled out in longhands deliberately: the shorthand's property name is
     also the name of a utility, and one of the ports compiles bare words
     found anywhere in this source tree into its own stylesheet. */
  [data-tz-showcase] a:focus-visible {
    outline-style: solid;
    outline-width: 2px;
    outline-color: var(--tz-ink);
    outline-offset: 3px;
    border-radius: 1px;
  }

  header {
    padding-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  /* The wordmark, not the headline: the project's name set small and quiet
     in the same face as its measurements, leaving the claim underneath it
     to carry the weight. */
  header h1 {
    margin: 0;
    font-family: var(--tz-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--tz-quiet);
  }

  /* The paragraph immediately after the wordmark is the claim; the one after
     that is the evidence for it. Selected by position rather than by a hook
     of its own, because its position in the markup is what makes it the
     claim. */
  header h1 + p {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    max-inline-size: 17ch;
    font-size: clamp(2.25rem, 7vw, 3.75rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.03em;
  }

  header h1 + p + p {
    margin: 1.5rem 0 0;
    max-inline-size: 58ch;
    color: var(--tz-quiet);
  }

  /* Given a size of its own because an inline drawing with no intrinsic
     dimensions falls back to 300×150, which renders its own labels at about
     6.75px. The ceiling is the same concern from the other side: the two
     outlines are read against each other, and a drawing wider than the prose
     beside it separates them further than the eye can hold in one glance.
     Its labels scale with the box, so on a narrow screen the surround gives
     up its own padding before the drawing gives up any width. */
  [data-tz-reach] {
    display: block;
    inline-size: 100%;
    max-inline-size: 34rem;
    block-size: auto;
    margin-block-start: clamp(2rem, 5vw, 3rem);
    padding: clamp(0.25rem, 2vw, 1.25rem);
    background: var(--tz-panel);
    border: 1px solid var(--tz-rule);
    color: var(--tz-ink);
  }

  [data-tz-showcase] > section {
    counter-increment: tz-section;
    border-block-start: 1px solid var(--tz-rule);
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  [data-tz-showcase] h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Numbered the way the document it describes is numbered. The leading zero
     keeps the index one width however far the count runs. */
  [data-tz-showcase] h2::before {
    content: counter(tz-section, decimal-leading-zero);
    margin-inline-end: 0.9em;
    font-family: var(--tz-mono);
    font-size: 0.7em;
    font-weight: 400;
    color: var(--tz-quiet);
  }

  [data-tz-showcase] section > p {
    margin: 0 0 1.25rem;
    max-inline-size: 62ch;
    color: var(--tz-quiet);
  }

  [data-tz-showcase] nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--tz-rule);
  }

  [data-tz-showcase] nav li {
    padding: 0.9rem 0 0.9rem 0.9rem;
    border-block-end: 1px solid var(--tz-rule);
    border-inline-start: 2px solid transparent;
  }

  /* Five labels in a ruled list inside a named navigation landmark, so they
     are legible as controls without each one carrying its own mark; the row
     they sit in, the edge marker and the focus indicator do that work. The rule
     beneath the label is still drawn, merely left uncoloured, so revealing
     it on hover reflows nothing and the row keeps its height whatever the
     reader is doing.

     Selected through the ancestor rather than on its own, which reads as
     redundant and is not: scoping splices an extra attribute into every
     compound selector, so the general rule above would otherwise out-specify
     this one and colour all five. */
  [data-tz-showcase] nav a[data-tz-system] {
    font-family: var(--tz-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration-color: transparent;
  }

  [data-tz-showcase] nav a[data-tz-system]:hover {
    text-decoration-color: currentColor;
  }

  [data-tz-note] {
    margin: 0.75rem 0 0;
    max-inline-size: 52ch;
    font-size: 0.9375rem;
    color: var(--tz-quiet);
  }

  /* Mobile first: a reader already holding a phone does not need a
     simulation of one. Below the breakpoint the frame does not appear at
     all, and the switcher links are ordinary navigation to the demo routes,
     full-screen and under a real thumb.

     The width is a literal because a CSS media condition cannot read a
     custom property, which is the same constraint
     systems/vanilla/src/thumbzone.css works under. It is held to
     DESKTOP_BREAKPOINT by e2e/showcase.spec.ts, probed at the boundary
     rather than well past it. */
  [data-tz-frame-host] {
    --tz-frame-pad: clamp(0.75rem, 2vw, 1.25rem);

    display: none;
    text-align: center;
    padding: var(--tz-frame-pad);
    background: var(--tz-panel);
    border: 1px solid var(--tz-rule);
  }

  @media (min-width: 768px) {
    /* Bounded by the frame's own width plus what is drawn around it, so the
       panel closes on the demo instead of stretching a plate of empty ground
       across the page at the widths where this is still one column. The
       padding is added to that figure rather than taken out of it — this
       sizes the surround, and leaves what the frame renders at alone. */
    [data-tz-frame-host] {
      display: block;
      margin: 2rem auto 0;
      max-inline-size: calc(var(--tz-frame-inline-size) + 2 * var(--tz-frame-pad) + 2px);
    }
  }

  /* Deliberately reaches past this page's scoping. Switching systems
     replaces the frame with an element the script creates itself, which
     carries none of the generated attributes a scoped rule matches on — so a
     scoped version of this would style the frame the server rendered and
     then stop applying the moment a reader chose anything else, which is
     precisely the state nobody reviews.

     No width and no box of its own, either. The width is the attribute the
     server computed against DESKTOP_BREAKPOINT: a rule that overrode it
     would let the framed demo widen enough to put away its own trigger and
     sheet, and an edge drawn here would come out of the viewport inside
     instead, framing the demo at a width it was never sized for. The
     surround is drawn by the panel around it, where it costs the demo
     nothing. */
  [data-tz-frame-host] :global(iframe[data-tz-frame]) {
    display: block;
    margin-inline: auto;
    border: 0;
    background: var(--tz-page);
  }

  [data-tz-frame-caption] {
    margin: 0.85rem 0 0;
    font-family: var(--tz-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--tz-quiet);
  }

  /* Left inside the framed area on purpose. It qualifies the frame and
     nothing else, so where no frame appears it has nothing to qualify — and
     a reader below the breakpoint is already doing the thing it asks for. */
  [data-tz-caveat] {
    margin: 0.85rem auto 0;
    max-inline-size: 36ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--tz-quiet);
  }

  /* Below the breakpoint every note is shown, beside the link it describes:
     there is no frame here for a caption to caption, and the links are the
     page's real navigation. Showing one system's note against five systems'
     links would read as though it applied to all of them.

     From the breakpoint up the note becomes a caption for the framed demo,
     so exactly one belongs on screen. Driven by data-tz-current rather than
     by aria-current, so the server can mark the initially framed system
     without asserting anything about navigation for a reader with no
     scripting. */
  @media (min-width: 768px) {
    [data-tz-note] {
      display: none;
    }

    [data-tz-current] [data-tz-note] {
      display: block;
    }

    /* The rule down the edge of a row means "this is the system in the
       frame", so it is drawn only where a frame exists. The server marks the
       first system whatever the width, and marking it below the breakpoint
       would announce a choice the reader never made. */
    [data-tz-showcase] nav li[data-tz-current] {
      border-inline-start-color: var(--tz-ink);
    }
  }

  /* Two columns once — and only once — there is room for the switcher's
     prose beside a 390px frame without either being squeezed. Deliberately
     not the contract's breakpoint: nothing about the pattern changes here,
     only how much room the page has to lay itself out in. The frame's track
     is sized to its own content, so nothing in this rule can widen or narrow
     what the server rendered. */
  @media (min-width: 62rem) {
    [data-tz-demo] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }

    [data-tz-demo] h2 {
      grid-column: 1 / -1;
    }

    [data-tz-frame-host] {
      margin: 0;
    }
  }

  /* Numbered clauses, monospaced and ruled off from each other, because that
     is what the list is: four of the checks the suite runs, quoted from the
     constants it runs them against. */
  [data-tz-contract] {
    counter-reset: tz-clause;
    margin: 0 0 1.5rem;
    padding: 0;
    max-inline-size: 64ch;
    list-style: none;
    border-block-start: 1px solid var(--tz-rule);
  }

  [data-tz-contract] li {
    counter-increment: tz-clause;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--tz-rule);
    font-family: var(--tz-mono);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  [data-tz-contract] li::before {
    content: counter(tz-clause, decimal-leading-zero);
    color: var(--tz-quiet);
  }

  [data-tz-planned] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  [data-tz-planned] li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--tz-rule);
    font-family: var(--tz-mono);
    font-size: 0.8125rem;
    color: var(--tz-quiet);
  }

  [data-tz-showcase] footer {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--tz-rule);
  }

  [data-tz-showcase] footer p {
    margin: 0;
    font-family: var(--tz-mono);
    font-size: 0.8125rem;
    color: var(--tz-quiet);
  }

  /* The only things that move are a rule arriving beneath a switcher label
     and the edge marker changing colour. Both are declared here rather than
     switched off further down, so a reader who has asked for less motion is
     never sent any and then told to ignore it. */
  @media (prefers-reduced-motion: no-preference) {
    [data-tz-showcase] a,
    [data-tz-showcase] nav li {
      transition:
        color 120ms ease-out,
        text-decoration-color 120ms ease-out,
        border-inline-start-color 120ms ease-out;
    }
  }
</style>

<script>
  import { DESKTOP_BREAKPOINT } from '../../../core/index.js'

  const host = document.querySelector('[data-tz-frame-host]')
  const links = document.querySelectorAll('a[data-tz-system]')

  // Below the breakpoint the frame is hidden and these links are the page's
  // real navigation: a reader on a phone wants the demo full-screen under an
  // actual thumb, not a simulation of a phone inside a phone. Matching the
  // same width the frame is shown at keeps one rule governing both.
  const framesAreShown = window.matchMedia(`(min-width: ${DESKTOP_BREAKPOINT}px)`)

  function swap(route, label) {
    const current = host?.querySelector('iframe')
    if (!current) return

    // Replaced rather than re-pointed. Assigning `src` to a frame already in
    // the document navigates it, and that navigation pushes an entry onto
    // *this* page's session history — so a reader who tried three systems and
    // pressed Back would walk backwards through the switcher instead of
    // leaving. A newly inserted frame's first load is a replacement, not a
    // push. It also guarantees a clean document: these routes wire a pointer
    // state machine, a focus trap and a scroll tracker at init, and a reused
    // frame would carry whatever state the last one was left in.
    const next = document.createElement('iframe')
    // Dimensions are copied from the element the server rendered rather than
    // recomputed here, so the width that is clamped against the breakpoint at
    // build time has exactly one source.
    next.width = current.width
    next.height = current.height
    next.setAttribute('data-tz-frame', '')
    next.title = `${label} demo`
    next.src = route
    current.replaceWith(next)
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      // Let the browser do its normal thing when the frame is not on screen,
      // and for any click the reader meant to open elsewhere.
      if (!framesAreShown.matches) return
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return

      event.preventDefault()
      swap(link.getAttribute('href') ?? '', link.textContent?.trim() ?? '')

      for (const other of links) other.removeAttribute('aria-current')
      link.setAttribute('aria-current', 'page')

      for (const item of document.querySelectorAll('[data-tz-current]')) {
        item.removeAttribute('data-tz-current')
      }
      link.closest('li')?.setAttribute('data-tz-current', '')
    })
  }

  // The server renders no aria-current, because without scripting these are
  // ordinary links to other pages and none of them is the current one.
  if (framesAreShown.matches) links[0]?.setAttribute('aria-current', 'page')
</script>
