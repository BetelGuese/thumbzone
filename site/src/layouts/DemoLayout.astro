---
interface Props {
  system: string
  /**
   * Attributes to put on `<html>`, for a system whose styling needs one there.
   *
   * Mantine is the first: 128 of the 270 `--mantine-color-*` properties
   * `@mantine/core/styles.css` declares — every scheme-dependent name among
   * them, `--mantine-color-body` and `--mantine-color-text` included — are
   * declared only under `:root[data-mantine-color-scheme='light'|'dark']` and
   * the matching `:host(...)` form, so a wrapper element inside the page
   * cannot carry it, and without it the sheet and the trigger both compute a
   * transparent background. The other 142, the palette scales plus
   * `--mantine-color-white` and `--mantine-color-black`, are unconditional,
   * which is why the symptom is white text on nothing rather than a blank
   * page. `MantineProvider` stamps the attribute
   * from an effect after hydration, which is far too late here: this pattern
   * is wired from a module script during load, deliberately, so that a
   * loaded page is a working one, and the trigger is on screen for that whole
   * window.
   *
   * Kept as an open map rather than a `colorScheme` prop so that this layout
   * stays system-agnostic — the routes that need an attribute know which one,
   * and the twelve routes that do not are unchanged. Nothing else reads
   * Mantine's attribute, and no other route links its stylesheet.
   */
  rootAttrs?: Record<string, string>
}
const { system, rootAttrs = {} } = Astro.props
---
<html lang="en" {...rootAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>thumbzone — {system}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
